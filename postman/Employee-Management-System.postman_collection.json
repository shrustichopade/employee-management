{
  "info": {
    "name": "Employee Management System",
    "description": "Employee Management System API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Get All Employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees"
      }
    },
    {
      "name": "Search Employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees?search=IT&sortBy=name&order=ASC"
      }
    },
    {
      "name": "Get Employee By ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    },
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"department\": \"IT\",\n  \"role\": \"Software Developer\",\n  \"salary\": 30000,\n  \"join_date\": \"2026-10-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/employees"
      }
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"department\": \"IT\",\n  \"role\": \"Senior Software Developer\",\n  \"salary\": 35000,\n  \"join_date\": \"2026-10-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    }
  ]
}